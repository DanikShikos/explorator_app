# Supabase Postgres connection string (Settings в†’ Database)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Вход по почте. Пароль хранит Supabase Auth в виде bcrypt-хеша, не в открытом виде.
# В кабинете Supabase: Authentication → URL Configuration → Redirect URLs
# добавьте http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# AI: приложение само переходит к следующему, если у провайдера кончился лимит
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
