# Copy to .env.local. Never commit .env, .env.local, or real keys.
# NEXT_PUBLIC_* is shipped to the browser. Do not put service-role or AI keys there.

# Supabase Postgres (Settings → Database). Use the pooler in production.
# This role bypasses Row Level Security. App isolation is getCurrentUserId() plus user_id filters.
# Do not point this at a superuser in a shared environment once a restricted role exists.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Email login. Supabase Auth stores a bcrypt hash, not the password.
# In the Supabase dashboard: Authentication → URL Configuration → Redirect URLs
# add http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# AI: the app moves to the next provider when one is out of quota.
# Server only. Required for generation; leave unset to disable AI.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Rate limit for AI routes (Upstash Redis REST). Both must be set in production.
# Without them, production generation returns 503. Local dev uses an in-process window.
# UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN
