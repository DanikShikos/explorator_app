{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/inject-design-desk.js",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/inject-design-desk.js",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/remind-design-contract.js",
        "timeout": 5,
        "matcher": "Write|StrReplace|Read|EditNotebook"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/remind-design-contract.js",
        "timeout": 5
      }
    ]
  }
}
